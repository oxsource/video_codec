package(default_visibility = ["//visibility:public"])

# FFmpeg cc_library wrapper over libavcodec / libavutil.
#
# NOTE (scaffold): this globs the FFmpeg 6.1 sources as the intended integration
# target. A fully buildable FFmpeg under Bazel also needs the configure-generated
# config.h / version.h and platform asm, which are NOT produced by this wrapper.
# That belongs to the real backend/ffmpeg encoder implementation (Phase 2, US1).
# Until then, treat this as the dependency placeholder the module graph expects.
cc_library(
    name = "ffmpeg_codec",
    hdrs = glob([
        "libavcodec/*.h",
        "libavcodec/**/*.h",
        "libavutil/*.h",
        "libavutil/**/*.h",
    ]),
    srcs = glob([
        "libavcodec/**/*.c",
        "libavutil/**/*.c",
    ]),
    includes = ["."],
    copts = [
        "-Wno-unused-parameter",
        "-Wno-deprecated-declarations",
    ],
    linkopts = select({
        "@//platforms:darwin_arm64_platform_setting": [
            "-framework VideoToolbox",
            "-framework CoreMedia",
        ],
        "//conditions:default": [],
    }),
)
