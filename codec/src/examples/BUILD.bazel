package(default_visibility = ["//visibility:public"])

# Runnable example: SMPTE color bars -> FFmpeg encoder (push) -> queue ->
# Await -> Muxer (.mp4 via FFmpeg backend muxer), or raw .h264 via
# FileConsumer. The FFmpeg static archive is force-loaded (ADR-001) exactly
# like the backend tests and ffmpeg_spike.
cc_binary(
    name = "ffmpeg_encode_file",
    srcs = ["ffmpeg_encode_file.cc"],
    data = [
        "@ffmpeg//:ffmpeg_codec_archive",
    ],
    linkopts = [
        "-Wl,-force_load,$(execpath @ffmpeg//:ffmpeg_codec_archive)",
    ],
    # Static linkage so the force_load above pulls the whole FFmpeg archive into
    # this binary (Bazel otherwise builds the backend as a dylib).
    linkstatic = True,
    deps = [
        "@video_codec//src/framework/public:video_codec",  # encoder API + FFmpeg backend
        "@video_codec//src/framework/queue",              # PacketQueue
        "@video_codec//src/framework/consumer",           # FileConsumer (raw mode)
        "@video_codec//src/framework/io",                 # FileByteSink (mp4 output)
        "@video_codec//src/framework/utils",              # SMPTE color-bars generator
    ],
)
