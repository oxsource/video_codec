package(default_visibility = [
    "//src/framework:__subpackages__",
    "//tests:__subpackages__",
    "//src/examples:__subpackages__",
])

# MP4 container format conversion (FFmpeg-based). Mp4Muxer is a pure format
# converter: Annex-B -> AVCC + avcC extradata, writing every output byte
# through a ByteSink (the muxer's output contract, defined here). File I/O and
# PacketConsumer adapters live in the consumer module, which depends on mux.
# Depends on FFmpeg's libavformat (see third_party/ffmpeg).
cc_library(
    name = "mux",
    srcs = glob(["*.cc"]),
    hdrs = glob(["*.h"]),
    includes = [".."],
    deps = [
        "//src/framework/core",
        "@ffmpeg//:ffmpeg_codec",
        "@ffmpeg//:ffmpeg_codec_impl",
    ],
)
