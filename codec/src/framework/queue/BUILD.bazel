package(default_visibility = ["@video_codec//src/framework:__subpackages__", "//tests:__subpackages__", "@video_codec//src/examples:__subpackages__"])

# One cc_library per module (a .cc/.h pair, or a header-only unit). The
# aggregate `queue` target deps on all modules for backward compatibility.

cc_library(
    name = "queue_iface",
    hdrs = ["queue_iface.h"],
    deps = [
        "@video_codec//src/framework/core:packet_sink",
        "@video_codec//src/framework/core:status",
        "@video_codec//src/framework/core:types",
    ],
)

cc_library(
    name = "packet_queue",
    srcs = ["packet_queue.cc"],
    hdrs = ["packet_queue.h"],
    deps = [
        ":queue_iface",
        "@video_codec//src/framework/core:log_slot",
        "@video_codec//src/framework/core:types",
    ],
)

cc_library(
    name = "queue",
    deps = [
        ":queue_iface",
        ":packet_queue",
    ],
)
