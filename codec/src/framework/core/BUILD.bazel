package(default_visibility = ["@video_codec//src/framework:__subpackages__", "//tests:__subpackages__", "@video_stream//src/examples:__subpackages__", "@video_stream//src/core:__subpackages__", "@video_stream//src/backend:__subpackages__", "@video_stream//tests:__subpackages__"])

# One cc_library per module (a .cc/.h pair, or a header-only unit). The
# aggregate `core` target deps on all modules for backward compatibility.

cc_library(
    name = "types",
    hdrs = [
        "types.h",
        "export.h",
    ],
)

cc_library(
    name = "packet_sink",
    hdrs = ["packet_sink.h"],
    deps = [
        ":status",
        ":types",
    ],
)

cc_library(
    name = "status",
    hdrs = [
        "status.h",
        "export.h",
    ],
)

cc_library(
    name = "result",
    hdrs = ["result.h"],
    deps = [":status"],
)

cc_library(
    name = "log_slot",
    srcs = ["log_slot.cc"],
    hdrs = [
        "log_slot.h",
        "export.h",
    ],
)

cc_library(
    name = "core",
    deps = [
        ":types",
        ":status",
        ":result",
        ":log_slot",
        ":packet_sink",
    ],
)
