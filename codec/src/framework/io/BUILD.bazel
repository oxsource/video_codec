package(default_visibility = [
    "//codec/src/framework:__subpackages__",  # incl. public umbrella (re-exports ByteSink/FileByteSink, D-1)
    "//codec/src/examples:__subpackages__",
    "//codec/tests:__subpackages__",
    "//stream/src/examples:__subpackages__",
    "//stream/src/core:__subpackages__",
    "//stream/src/backend:__subpackages__",
    "//stream/tests:__subpackages__",
])

# Byte-level output: the single ByteSink contract (used by muxers) and its
# concrete sinks (file / stream / tee). A network/cloud output is just a
# ByteSink whose Seek/Tell are unsupported — no separate transport interface.
# One cc_library per module; the aggregate `io` target deps on all for backward
# compatibility. Depends on nothing (a leaf).

cc_library(
    name = "byte_sink",
    hdrs = ["byte_sink.h"],
)

cc_library(
    name = "file_byte_sink",
    srcs = ["file_byte_sink.cc"],
    hdrs = ["file_byte_sink.h"],
    deps = [":byte_sink"],
)

cc_library(
    name = "stream_byte_sink",
    hdrs = ["stream_byte_sink.h"],
    deps = [":byte_sink"],
)

cc_library(
    name = "tee_byte_sink",
    hdrs = ["tee_byte_sink.h"],
    deps = [":byte_sink"],
)

cc_library(
    name = "io",
    deps = [
        ":byte_sink",
        ":file_byte_sink",
        ":stream_byte_sink",
        ":tee_byte_sink",
    ],
)
