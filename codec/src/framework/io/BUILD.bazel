package(default_visibility = [
    "//src/framework:__subpackages__",
    "//src/examples:__subpackages__",
    "//tests:__subpackages__",
])

# Byte-level output: the single ByteWriter contract (used by muxers) and its
# concrete writers (file / stream / tee). A network/cloud output is just a
# ByteWriter whose Seek/Tell are unsupported — no separate transport interface.
# One cc_library per module; the aggregate `io` target deps on all for backward
# compatibility. Depends on nothing (a leaf).

cc_library(
    name = "byte_writer",
    hdrs = ["byte_writer.h"],
    includes = [".."],
)

cc_library(
    name = "file_writer",
    srcs = ["file_writer.cc"],
    hdrs = ["file_writer.h"],
    includes = [".."],
    deps = [":byte_writer"],
)

cc_library(
    name = "stream_writer",
    hdrs = ["stream_writer.h"],
    includes = [".."],
    deps = [":byte_writer"],
)

cc_library(
    name = "tee_writer",
    hdrs = ["tee_writer.h"],
    includes = [".."],
    deps = [":byte_writer"],
)

cc_library(
    name = "io",
    deps = [
        ":byte_writer",
        ":file_writer",
        ":stream_writer",
        ":tee_writer",
    ],
)
