package(default_visibility = ["//codec/src/framework:__subpackages__", "//codec/tests:__subpackages__"])

# Generic FFmpeg backend (libx264 / libx265 / AAC / Opus). Default backend on all
# non-Android platforms.
#
# NOTE: FFmpeg is linked as a static force-loaded archive (ADR-001). The
# -Wl,-force_load linkopt is applied by each consuming binary (mirroring
# ffmpeg_spike), because Bazel cannot expand $(execpath) in a cc_library's
# linkopts when it is linked into a dylib. Consumers of this backend MUST add:
#   data = ["@ffmpeg//:ffmpeg_codec_archive"],
#   linkopts = ["-Wl,-force_load,$(execpath @ffmpeg//:ffmpeg_codec_archive)"],
#
# One cc_library per module (a .cc/.h pair, or a header-only unit). The
# aggregate `ffmpeg` target deps on all modules for backward compatibility.
# Each module self-registers its creator into the factory via the
# VIDEO_CODEC_REGISTER_* macros at the bottom of its .cc, and carries alwayslink so the
# static initializer is force-loaded into any binary that links this backend —
# otherwise CodecFactory::CreateVideo returns nullptr.

cc_library(
    name = "ffmpeg_raii",
    hdrs = ["ffmpeg_raii.h"],
)

cc_library(
    name = "ffmpeg_video",
    srcs = ["ffmpeg_video.cc"],
    hdrs = ["ffmpeg_video.h"],
    alwayslink = True,
    deps = [
        ":ffmpeg_raii",
        "//codec/src/framework/api:codec_factory",
        "//codec/src/framework/api:encoder_lifecycle",
        "//codec/src/framework/api:video_encoder",
        "//codec/src/framework/core:log_slot",
        "//codec/src/framework/core:types",
        "//codec/src/framework/queue:queue_iface",
        "@ffmpeg//:ffmpeg_codec",
        "@ffmpeg//:ffmpeg_codec_impl",
    ],
)

cc_library(
    name = "ffmpeg_audio",
    srcs = ["ffmpeg_audio.cc"],
    hdrs = ["ffmpeg_audio.h"],
    alwayslink = True,
    deps = [
        ":ffmpeg_raii",
        "//codec/src/framework/api:audio_encoder",
        "//codec/src/framework/api:codec_factory",
        "//codec/src/framework/api:encoder_lifecycle",
        "//codec/src/framework/core:types",
        "//codec/src/framework/queue:queue_iface",
        "@ffmpeg//:ffmpeg_codec",
        "@ffmpeg//:ffmpeg_codec_impl",
    ],
)

cc_library(
    name = "ffmpeg_muxer",
    srcs = ["ffmpeg_muxer.cc"],
    hdrs = ["ffmpeg_muxer.h"],
    alwayslink = True,
    deps = [
        "//codec/src/framework/api:codec_factory",
        "//codec/src/framework/api:muxer",
        "//codec/src/framework/core:types",
        "//codec/src/framework/io:byte_sink",
        "@ffmpeg//:ffmpeg_codec",
        "@ffmpeg//:ffmpeg_codec_impl",
    ],
)

cc_library(
    name = "ffmpeg",
    deps = [
        ":ffmpeg_video",
        ":ffmpeg_audio",
        ":ffmpeg_muxer",
    ],
)
