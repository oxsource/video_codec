package(default_visibility = ["@video_codec//src/framework:__subpackages__", "//tests:__subpackages__"])

# Generic FFmpeg backend (libx264 / libx265 / AAC / Opus). Default backend on all
# non-Android platforms.
#
# NOTE: FFmpeg is linked as a static force-loaded archive (ADR-001). The
# -Wl,-force_load linkopt is applied by each consuming binary (mirroring
# ffmpeg_spike), because Bazel cannot expand $(execpath) in a cc_library's
# linkopts when it is linked into a dylib. Consumers of this backend MUST add:
#   data = ["@ffmpeg//:ffmpeg_codec_archive"],
#   linkopts = ["-Wl,-force_load,$(execpath @ffmpeg//:ffmpeg_codec_archive)"],
#
# One cc_library per module (a .cc/.h pair, or a header-only unit). The
# aggregate `ffmpeg` target deps on all modules for backward compatibility.
# `register` carries alwayslink so its object (static initializer
# self-registering the backend in the factory) is force-loaded into any binary
# that links this backend — otherwise CodecFactory::CreateVideo returns
# nullptr.

cc_library(
    name = "ffmpeg_raii",
    hdrs = ["ffmpeg_raii.h"],
    includes = ["."],
)

cc_library(
    name = "video_encoder",
    srcs = ["ffmpeg_video.cc"],
    hdrs = ["ffmpeg_video.h"],
    includes = ["."],
    deps = [
        ":ffmpeg_raii",
        "@video_codec//src/framework/api:encoder_lifecycle",
        "@video_codec//src/framework/api:video_encoder",
        "@video_codec//src/framework/core:log_slot",
        "@video_codec//src/framework/core:types",
        "@video_codec//src/framework/queue:queue_iface",
        "@ffmpeg//:ffmpeg_codec",
        "@ffmpeg//:ffmpeg_codec_impl",
    ],
)

cc_library(
    name = "audio_encoder",
    srcs = ["ffmpeg_audio.cc"],
    hdrs = ["ffmpeg_audio.h"],
    includes = ["."],
    deps = [
        ":ffmpeg_raii",
        "@video_codec//src/framework/api:audio_encoder",
        "@video_codec//src/framework/api:encoder_lifecycle",
        "@video_codec//src/framework/core:types",
        "@video_codec//src/framework/queue:queue_iface",
        "@ffmpeg//:ffmpeg_codec",
        "@ffmpeg//:ffmpeg_codec_impl",
    ],
)

cc_library(
    name = "muxer",
    srcs = ["ffmpeg_muxer.cc"],
    hdrs = ["ffmpeg_muxer.h"],
    includes = ["."],
    deps = [
        "@video_codec//src/framework/api:muxer",
        "@video_codec//src/framework/core:types",
        "@video_codec//src/framework/io:byte_sink",
        "@ffmpeg//:ffmpeg_codec",
        "@ffmpeg//:ffmpeg_codec_impl",
    ],
)

cc_library(
    name = "register",
    srcs = ["register.cc"],
    includes = ["."],
    alwayslink = True,
    deps = [
        ":audio_encoder",
        ":muxer",
        ":video_encoder",
        "@video_codec//src/framework/api:codec_factory",
    ],
)

cc_library(
    name = "ffmpeg",
    deps = [
        ":video_encoder",
        ":audio_encoder",
        ":muxer",
        ":register",
    ],
)
