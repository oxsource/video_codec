package(default_visibility = ["//src/framework:__subpackages__", "//tests:__subpackages__", "//src/examples:__subpackages__"])

# PacketConsumer (implements queue::PacketSink), file sinks (FileSinkConsumer,
# FileByteSink), and the PacketConsumer adapters over format converters
# (Mp4FileConsumer: FileByteSink + mux::Mp4Muxer). The drain loop lives in
# PacketSource::Await (queue module); this module only supplies sinks.
# Depends on core (types), queue (PacketSource), api, and mux (format).
cc_library(
    name = "consumer",
    srcs = glob(["*.cc"]),
    hdrs = glob(["*.h"]),
    includes = [".."],
    deps = [
        "//src/framework/core",
        "//src/framework/api",
        "//src/framework/queue",
        "//src/framework/mux",
    ],
)
