package(default_visibility = ["//src/framework:__subpackages__", "//tests:__subpackages__", "//src/examples:__subpackages__"])

# One cc_library per module (a .cc/.h pair, or a header-only unit). The
# aggregate `consumer` target deps on all modules for backward compatibility.
#   PacketConsumer (implements queue::PacketSink), FileSinkConsumer (raw
#   Annex-B / ADTS), FileByteSink (file I/O), ByteStream + StreamByteSink
#   (cloud/network push), TeeByteSink (fan-out), Mp4Consumer (any ByteSink +
#   mux::Mp4Muxer).
# The drain loop lives in PacketSource::Await (queue module); this module only
# supplies sinks.

cc_library(
    name = "packet_consumer",
    hdrs = ["packet_consumer.h"],
    includes = [".."],
    deps = [
        "//src/framework/core:status",
        "//src/framework/core:types",
        "//src/framework/queue:queue_iface",
    ],
)

cc_library(
    name = "byte_stream",
    hdrs = ["byte_stream.h"],
    includes = [".."],
    deps = ["//src/framework/core:status"],
)

cc_library(
    name = "file_byte_sink",
    srcs = ["file_byte_sink.cc"],
    hdrs = ["file_byte_sink.h"],
    includes = [".."],
    deps = ["//src/framework/mux:byte_sink"],
)

cc_library(
    name = "stream_byte_sink",
    hdrs = ["stream_byte_sink.h"],
    includes = [".."],
    deps = [
        ":byte_stream",
        "//src/framework/mux:byte_sink",
    ],
)

cc_library(
    name = "tee_byte_sink",
    hdrs = ["tee_byte_sink.h"],
    includes = [".."],
    deps = ["//src/framework/mux:byte_sink"],
)

cc_library(
    name = "file_sink_consumer",
    srcs = ["file_sink_consumer.cc"],
    hdrs = ["file_sink_consumer.h"],
    includes = [".."],
    deps = [":packet_consumer"],
)

cc_library(
    name = "mp4_consumer",
    srcs = ["mp4_consumer.cc"],
    hdrs = ["mp4_consumer.h"],
    includes = [".."],
    deps = [
        ":packet_consumer",
        "//src/framework/core:types",
        "//src/framework/mux:byte_sink",
        "//src/framework/mux:mp4_muxer",
    ],
)

cc_library(
    name = "consumer",
    deps = [
        ":packet_consumer",
        ":byte_stream",
        ":file_byte_sink",
        ":stream_byte_sink",
        ":tee_byte_sink",
        ":file_sink_consumer",
        ":mp4_consumer",
    ],
)
