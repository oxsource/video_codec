package(default_visibility = ["@video_codec//src/framework:__subpackages__", "//tests:__subpackages__", "@video_codec//src/examples:__subpackages__"])

# One cc_library per module (a .cc/.h pair, or a header-only unit). The
# aggregate `consumer` target deps on all modules for backward compatibility.
#   PacketConsumer (implements core::PacketSink), FileConsumer (raw
#   Annex-B / ADTS). MP4 muxing now lives in the api Muxer interface +
#   backend implementations, so no mp4 consumer exists here.
# Byte-level sinks (file / stream / tee) live in the `io` module; the drain
# loop lives in PacketSource::Await (queue module).

cc_library(
    name = "packet_consumer",
    hdrs = ["packet_consumer.h"],
    includes = ["."],
    deps = [
        "@video_codec//src/framework/core:packet_sink",
        "@video_codec//src/framework/core:status",
        "@video_codec//src/framework/core:types",
    ],
)

cc_library(
    name = "file_consumer",
    srcs = ["file_consumer.cc"],
    hdrs = ["file_consumer.h"],
    includes = ["."],
    deps = [
        ":packet_consumer",
        "@video_codec//src/framework/io:file_byte_sink",
    ],
)

cc_library(
    name = "consumer",
    deps = [
        ":packet_consumer",
        ":file_consumer",
    ],
)
