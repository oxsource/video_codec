package(default_visibility = ["//src/framework:__subpackages__", "//tests:__subpackages__", "//src/examples:__subpackages__"])

# One cc_library per module (a .cc/.h pair, or a header-only unit). The
# aggregate `consumer` target deps on all modules for backward compatibility.
#   PacketConsumer (implements queue::PacketSink), FileSinkConsumer (raw
#   Annex-B / ADTS), Mp4Consumer (any io::ByteSink + mux::Mp4Muxer).
# Byte-level sinks (file / stream / tee) live in the `io` module; the drain
# loop lives in PacketSource::Await (queue module).

cc_library(
    name = "packet_consumer",
    hdrs = ["packet_consumer.h"],
    includes = [".."],
    deps = [
        "//src/framework/core:status",
        "//src/framework/core:types",
        "//src/framework/queue:queue_iface",
    ],
)

cc_library(
    name = "file_sink_consumer",
    srcs = ["file_sink_consumer.cc"],
    hdrs = ["file_sink_consumer.h"],
    includes = [".."],
    deps = [
        ":packet_consumer",
        "//src/framework/io:file_byte_sink",
    ],
)

cc_library(
    name = "mp4_consumer",
    srcs = ["mp4_consumer.cc"],
    hdrs = ["mp4_consumer.h"],
    includes = [".."],
    deps = [
        ":packet_consumer",
        "//src/framework/core:types",
        "//src/framework/io:byte_sink",
        "//src/framework/mux:mp4_muxer",
    ],
)

cc_library(
    name = "consumer",
    deps = [
        ":packet_consumer",
        ":file_sink_consumer",
        ":mp4_consumer",
    ],
)
