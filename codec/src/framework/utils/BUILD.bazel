package(default_visibility = [
    "//src/framework:__subpackages__",
    "//src/examples:__subpackages__",
    "//tests:__subpackages__",
])

# One cc_library per module (a .cc/.h pair). The aggregate `utils` target deps
# on all modules for backward compatibility.

cc_library(
    name = "smpte_bars",
    srcs = ["smpte_bars.cc"],
    hdrs = ["smpte_bars.h"],
    includes = [".."],
    deps = ["//src/framework/core:types"],
)

cc_library(
    name = "stride",
    srcs = ["stride.cc"],
    hdrs = ["stride.h"],
    includes = [".."],
    deps = ["//src/framework/core:types"],
)

cc_library(
    name = "utils",
    deps = [
        ":smpte_bars",
        ":stride",
    ],
)
