package(default_visibility = [
    "@video_codec//src/framework:__subpackages__",
    "@video_codec//src/examples:__subpackages__",
    "//tests:__subpackages__",
])

# One cc_library per module (a .cc/.h pair). The aggregate `utils` target deps
# on all modules for backward compatibility.

cc_library(
    name = "egl_surface",
    srcs = ["egl_surface.cc"],
    hdrs = ["egl_surface.h"],
    # Android only: EGL window-surface setup uses ANativeWindow + EGL
    # (libandroid/libEGL/libGLESv2). Host builds get no linkopts (the class is
    # a stub there).
    linkopts = select({
        "//platforms:android_arm64_platform_setting": ["-landroid", "-lEGL", "-lGLESv2"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "smpte_bars",
    srcs = ["smpte_bars.cc"],
    hdrs = ["smpte_bars.h"],
    deps = [
        ":egl_surface",
        "@video_codec//src/framework/core:types",
    ],
)

cc_library(
    name = "stride",
    srcs = ["stride.cc"],
    hdrs = ["stride.h"],
    deps = ["@video_codec//src/framework/core:types"],
)

cc_library(
    name = "media_format",
    hdrs = ["media_format.h"],
)

cc_library(
    name = "utils",
    deps = [
        ":egl_surface",
        ":media_format",
        ":smpte_bars",
        ":stride",
    ],
)
