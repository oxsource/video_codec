package(default_visibility = [
    "@video_codec//src/framework:__subpackages__",
    "@video_codec//src/examples:__subpackages__",
    "//tests:__subpackages__",
])

# One cc_library per module (a .cc/.h pair). The aggregate `utils` target deps
# on all modules for backward compatibility.

cc_library(
    name = "smpte_bars",
    srcs = ["smpte_bars.cc"],
    hdrs = ["smpte_bars.h"],
    includes = ["."],
    deps = ["@video_codec//src/framework/core:types"],
)

cc_library(
    name = "stride",
    srcs = ["stride.cc"],
    hdrs = ["stride.h"],
    includes = ["."],
    deps = ["@video_codec//src/framework/core:types"],
)

cc_library(
    name = "media_format",
    hdrs = ["media_format.h"],
    includes = ["."],
)

cc_library(
    name = "utils",
    deps = [
        ":media_format",
        ":smpte_bars",
        ":stride",
    ],
)
