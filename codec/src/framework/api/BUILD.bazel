package(default_visibility = ["@video_codec//src/framework:__subpackages__", "//tests:__subpackages__"])

# One cc_library per module (a .cc/.h pair, or a header-only unit). The
# aggregate `api` target deps on all modules for backward compatibility.

cc_library(
    name = "video_encoder",
    hdrs = ["video_encoder.h"],
    includes = ["."],
    deps = [
        "@video_codec//src/framework/core:result",
        "@video_codec//src/framework/core:types",
    ],
)

cc_library(
    name = "audio_encoder",
    hdrs = ["audio_encoder.h"],
    includes = ["."],
    deps = [
        "@video_codec//src/framework/core:result",
        "@video_codec//src/framework/core:types",
    ],
)

cc_library(
    name = "encoder_lifecycle",
    srcs = ["encoder_lifecycle.cc"],
    hdrs = ["encoder_lifecycle.h"],
    includes = ["."],
    deps = ["@video_codec//src/framework/core:status"],
)

cc_library(
    name = "muxer",
    hdrs = ["muxer.h"],
    includes = ["."],
    deps = [
        "@video_codec//src/framework/core:packet_sink",
        "@video_codec//src/framework/core:result",
        "@video_codec//src/framework/core:status",
        "@video_codec//src/framework/core:types",
    ],
)

cc_library(
    name = "codec_factory",
    srcs = ["codec_factory.cc"],
    hdrs = ["codec_factory.h"],
    includes = ["."],
    deps = [
        ":audio_encoder",
        ":muxer",
        ":video_encoder",
        "@video_codec//src/framework/core:types",
    ],
)

cc_library(
    name = "input_surface",
    hdrs = ["input_surface.h"],
    includes = ["."],
)

cc_library(
    name = "api",
    deps = [
        ":video_encoder",
        ":audio_encoder",
        ":encoder_lifecycle",
        ":muxer",
        ":codec_factory",
        ":input_surface",
    ],
)
