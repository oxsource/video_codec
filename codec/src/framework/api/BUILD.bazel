package(default_visibility = ["//src/framework:__subpackages__", "//tests:__subpackages__"])

# One cc_library per module (a .cc/.h pair, or a header-only unit). The
# aggregate `api` target deps on all modules for backward compatibility.

cc_library(
    name = "video_encoder",
    hdrs = ["video_encoder.h"],
    includes = [".."],
    deps = [
        "//src/framework/core:result",
        "//src/framework/core:types",
    ],
)

cc_library(
    name = "audio_encoder",
    hdrs = ["audio_encoder.h"],
    includes = [".."],
    deps = [
        "//src/framework/core:result",
        "//src/framework/core:types",
    ],
)

cc_library(
    name = "encoder_lifecycle",
    srcs = ["encoder_lifecycle.cc"],
    hdrs = ["encoder_lifecycle.h"],
    includes = [".."],
    deps = ["//src/framework/core:status"],
)

cc_library(
    name = "encoder_factory",
    srcs = ["encoder_factory.cc"],
    hdrs = ["encoder_factory.h"],
    includes = [".."],
    deps = [
        ":audio_encoder",
        ":video_encoder",
        "//src/framework/core:types",
    ],
)

cc_library(
    name = "input_surface",
    hdrs = ["input_surface.h"],
    includes = [".."],
)

cc_library(
    name = "api",
    deps = [
        ":video_encoder",
        ":audio_encoder",
        ":encoder_lifecycle",
        ":encoder_factory",
        ":input_surface",
    ],
)
