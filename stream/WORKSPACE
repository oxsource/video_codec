workspace(name = "video_stream")

load("@bazel_tools//tools/build_defs/repo:git.bzl", "new_git_repository")
load("//:video_stream_deps.bzl", "video_stream_setup")
load("@bazel_tools//tools/cpp:cc_configure.bzl", "cc_configure")

video_stream_setup()

cc_configure()

load("@rules_foreign_cc//foreign_cc:repositories.bzl", "rules_foreign_cc_dependencies")

rules_foreign_cc_dependencies(
    register_built_tools = False,
    register_built_pkgconfig_toolchain = False,
)

# libdatachannel — WebRTC stack with ICE, DTLS, SRTP, SCTP.
new_git_repository(
    name = "libdatachannel",
    remote = "https://github.com/paullouisageneau/libdatachannel.git",
    tag = "v0.21.2",
    init_submodules = True,
    build_file = "//third_party/libdatachannel:BUILD.bazel",
)

# OpenSSL for libdatachannel (DTLS support).
new_local_repository(
    name = "openssl",
    path = "/opt/homebrew/Cellar/openssl@3/3.6.3",
    build_file = "//third_party/openssl:BUILD.bazel",
)

local_repository(
    name = "video_codec",
    path = "../codec",
)