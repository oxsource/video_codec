package(default_visibility = ["//visibility:public"])

load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")

filegroup(
    name = "all",
    srcs = glob(["**/*"]),
)

# Executable archiver shim (see ar_wrapper.sh): Bazel's macOS toolchain drives
# libtool with ARFLAGS="-static -s <out>" which Apple libtool rejects, so route
# AR through this wrapper. On Linux it execs the system ar unchanged.
genrule(
    name = "ar_wrapper",
    srcs = ["ar_wrapper.sh"],
    outs = ["ar_wrapper.bin"],
    cmd = "cp $(location ar_wrapper.sh) $@ && chmod +x $@",
)

# OpenSSL built from source via rules_foreign_cc (configure_make) so the build
# is cross-platform (host macOS/Linux; Android webrtc cross-compile is a
# follow-up). OpenSSL must be configured in-tree; static libs (libssl.a +
# libcrypto.a) avoid platform-specific shared-library names. The Configure
# target is selected by host platform. Installed headers are exposed to
# dependents via out_include_dir (foreign_cc CcInfo).
configure_make(
    name = "openssl_impl",
    # NOTE: must reference the external repo explicitly — the relative `:all`
    # inside this build_file resolves to the local //third_party/openssl package
    # (which only contains this BUILD file), not the @openssl source tree.
    lib_source = "@openssl//:all",
    configure_in_place = True,
    configure_command = "Configure",
    configure_options = [
        "no-shared",
        "no-tests",
        "--openssldir=/usr/local/ssl",
    ] + select({
        "@video_stream//platforms:darwin_arm64_platform_setting": ["darwin64-arm64-cc"],
        # linux x86_64 host (CI) + fallback
        "//conditions:default": ["linux-x86_64"],
    }),
    # install_dev installs libs + headers + pkgconfig WITHOUT the openssl CLI
    # (build_programs links apps/openssl, which fails on macOS arm64 with a
    # _OPENSSL_armcap_P adrp fixup error we don't need to chase).
    targets = ["install_dev"],
    out_static_libs = ["libssl.a", "libcrypto.a"],
    out_include_dir = "include",
    env = {
        # Route archiving through the shim so Apple libtool (Bazel's macOS AR)
        # gets the `-o` it requires; GNU ar on Linux passes through.
        "AR": "$$EXT_BUILD_ROOT$$/$(location :ar_wrapper)",
    },
    build_data = [":ar_wrapper"],
)

cc_library(
    name = "openssl",
    deps = [":openssl_impl"],
)
