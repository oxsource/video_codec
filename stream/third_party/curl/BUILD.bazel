package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all",
    srcs = glob(["**/*"]),
)

# Build libcurl from source with cmake (no SSL, no HTTP2, minimal).
load("@rules_foreign_cc//foreign_cc:cmake.bzl", "cmake")

cmake(
    name = "curl",
    lib_source = ":all",
    out_static_libs = ["libcurl.a"],
    cache_entries = {
        "CMAKE_POSITION_INDEPENDENT_CODE": "ON",
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "CURL_USE_OPENSSL": "OFF",
        "CURL_USE_SCHANNEL": "OFF",
        "CURL_USE_SECURETRANSPORT": "OFF",
        "CURL_USE_GSSAPI": "OFF",
        "CURL_USE_LDAP": "OFF",
        "CURL_USE_LIBPSL": "OFF",
        "CURL_DISABLE_LDAP": "ON",
        "CURL_DISABLE_TELNET": "ON",
        "CURL_DISABLE_DICT": "ON",
        "CURL_DISABLE_FILE": "ON",
        "CURL_DISABLE_TFTP": "ON",
        "CURL_DISABLE_RTSP": "ON",
        "CURL_DISABLE_POP3": "ON",
        "CURL_DISABLE_IMAP": "ON",
        "CURL_DISABLE_SMTP": "ON",
        "CURL_DISABLE_GOPHER": "ON",
        "CURL_DISABLE_SMB": "ON",
        "CURL_DISABLE_MQTT": "ON",
        "HTTP_ONLY": "ON",
        "BUILD_CURL_EXE": "OFF",
        "BUILD_TESTING": "OFF",
    },
)

cc_library(
    name = "libcurl",
    deps = [":curl"],
    includes = ["include"],
)