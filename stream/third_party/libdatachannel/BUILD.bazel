package(default_visibility = ["//visibility:public"])

load("@rules_foreign_cc//foreign_cc:cmake.bzl", "cmake")

filegroup(
    name = "all",
    srcs = glob(["**/*"]),
)

cmake(
    name = "libdatachannel",
    # NOTE: reference the external repo explicitly — the relative `:all` would
    # resolve to the local //third_party/libdatachannel package instead of the
    # @libdatachannel source tree.
    lib_source = "@libdatachannel//:all",
    out_shared_libs = select({
        "@video_stream//platforms:darwin_arm64_platform_setting": [
            "libdatachannel.dylib",
            "libdatachannel.0.dylib",
        ],
        # linux x86_64 (CI) + fallback; copy_directory dereferences the CMake
        # versioned symlinks so each listed name lands as a real file.
        "//conditions:default": ["libdatachannel.so"],
    }),
    cache_entries = {
        "CMAKE_POSITION_INDEPENDENT_CODE": "ON",
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "NO_WEBSOCKET": "ON",
        "NO_EXAMPLES": "ON",
        "NO_TESTS": "ON",
        "USE_GNUTLS": "OFF",
        "USE_MBEDTLS": "OFF",
    },
    # OpenSSL comes from cpp_network's source-built TLS bundle (never a
    # stream-maintained OpenSSL), routed per platform like other cross-build
    # settings: the android_arm64 config links the NDK-built bundle, host
    # configs (macOS/Linux) link the native one.
    deps = select({
        "@video_stream//platforms:android_arm64_platform_setting": [
            "@cpp_network//third_party/tls/android:openssl",
        ],
        # linux x86_64 (CI) + fallback.
        "//conditions:default": [
            "@cpp_network//third_party/tls/host:openssl",
        ],
    }),
)

cc_library(
    name = "datachannel",
    deps = [":libdatachannel"],
    includes = ["include"],
)