package(default_visibility = ["//codec/src/framework:__subpackages__", "//codec/tests:__subpackages__", "//stream/src/examples:__subpackages__", "//stream/src/core:__subpackages__", "//stream/src/backend:__subpackages__", "//stream/tests:__subpackages__"])

# One cc_library per module (a .cc/.h pair, or a header-only unit). The
# aggregate `api` target deps on all modules for backward compatibility.

cc_library(
    name = "video_encoder",
    hdrs = ["video_encoder.h"],
    deps = [
        "//codec/src/framework/core:result",
        "//codec/src/framework/core:types",
    ],
)

cc_library(
    name = "audio_encoder",
    hdrs = ["audio_encoder.h"],
    deps = [
        "//codec/src/framework/core:result",
        "//codec/src/framework/core:types",
    ],
)

cc_library(
    name = "encoder_lifecycle",
    srcs = ["encoder_lifecycle.cc"],
    hdrs = ["encoder_lifecycle.h"],
    deps = ["//codec/src/framework/core:status"],
)

cc_library(
    name = "muxer",
    hdrs = ["muxer.h"],
    deps = [
        "//codec/src/framework/core:packet_sink",
        "//codec/src/framework/core:result",
        "//codec/src/framework/core:status",
        "//codec/src/framework/core:types",
    ],
)

cc_library(
    name = "codec_factory",
    srcs = ["codec_factory.cc"],
    hdrs = ["codec_factory.h"],
    deps = [
        ":audio_encoder",
        ":muxer",
        ":video_encoder",
        "//codec/src/framework/core:types",
    ],
)

cc_library(
    name = "api",
    deps = [
        ":video_encoder",
        ":audio_encoder",
        ":encoder_lifecycle",
        ":muxer",
        ":codec_factory",
    ],
)
