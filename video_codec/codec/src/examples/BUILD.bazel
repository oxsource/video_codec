package(default_visibility = ["//visibility:public"])

# Runnable example: SMPTE color bars + 1 kHz test tone -> encoder (push) ->
# queue -> Await -> Muxer (.mp4), or raw .h264 via FileConsumer. The backend
# is resolved automatically by platform (Backend::kAuto: FFmpeg on host,
# Android MediaCodec on Android): the `public:video_codec` dep links the
# platform backend via select(). No per-consumer FFmpeg link flags are needed:
# the backend's `alwayslink` + FFmpeg `cc_import` (ADR-001) make Bazel
# force-load the FFmpeg archive automatically, so consumers never touch FFmpeg.
cc_binary(
    name = "encode_file",
    srcs = ["encode_file.cc"],
    linkstatic = True,
    deps = [
        "//codec/src/framework/public:video_codec",  # encoder API + platform backend
        "//codec/src/framework/queue",              # PacketQueue
        "//codec/src/framework/consumer",           # FileConsumer (raw mode)
        "//codec/src/framework/io",                 # FileByteSink (mp4 output)
        "//codec/src/framework/utils",              # SMPTE color-bars generator
    ],
)
