package(default_visibility = ["//visibility:public"])

# Android MediaCodec backend dependency (spec 006): links the NDK media library
# (libmediandk — AMediaCodec / AMediaFormat / AMediaMuxer). The @androidndk
# repository (rules_android_ndk, registered in WORKSPACE) supplies the Android
# cc_toolchain and NDK sysroot; `-lmediandk` resolves against
# $sysroot/usr/lib/<triple>/<api>/libmediandk.so during Android cross-builds.
# Android-only so the host (Linux/macOS) build stays NDK-free.
cc_library(
    name = "android_media_codec",
    target_compatible_with = ["@platforms//os:android"],
    linkopts = ["-lmediandk"],
)
