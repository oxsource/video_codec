package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "encode_and_push",
    srcs = ["encode_and_push.cc"],
    linkopts = select({
        "//platforms:darwin_arm64_platform_setting": [
            "-Wl,-rpath,@loader_path/../../external/libdatachannel/libdatachannel/lib",
        ],
        # linux x86_64 + Android: $ORIGIN is the Linux/ELF rpath token.
        "//conditions:default": [
            "-Wl,-rpath,$ORIGIN/../../external/libdatachannel/libdatachannel/lib",
        ],
    }),
    deps = [
        "//stream/src/api:stream_api",
        "//stream/src/core:stream_core",
        "//stream/src/backend/webrtc:webrtc_backend",
        "//codec/src/framework/public:video_codec",
        "//codec/src/framework/queue",
        "//codec/src/framework/consumer",
        "//codec/src/framework/core:packet_sink",
    ],
)