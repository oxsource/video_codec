package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "encode_and_push",
    srcs = ["encode_and_push.cc"],
    deps = [
        # Stream public aggregate: stream_api + stream_core + the platform
        # backend (webrtc) are wired in internally, so this example never names
        # webrtc_backend or libdatachannel, and the datachannel rpath propagates
        # from webrtc_backend's linkopts instead of being hand-written here.
        "//stream/src/public:video_stream",
        # All codec pipeline capability via the stream-facing adapter
        # (encoder -> queue -> muxer/file sink).
        "//codec/src/framework:codec_for_stream",
    ],
)