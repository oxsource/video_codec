package(default_visibility = ["//visibility:public"])

cc_library(
    name = "stream_core",
    srcs = [
        "abr_controller.cc",
        "backend_registry.cc",
        "reconnect_handler.cc",
        "stream_config.cc",
        "stream_factory.cc",
        "stream_impl.cc",
    ],
    hdrs = [
        "abr_controller.h",
        "backend_registry.h",
        "reconnect_handler.h",
        "stream_impl.h",
        "video_stream_register.h",
    ],
    deps = [
        "//stream/src/api:stream_api",
        "//codec/src/framework:codec_for_stream",  # all codec capability via adapter
        "@nlohmann_json//:json",
    ],
)

cc_test(
    name = "reconnect_handler_test",
    srcs = ["reconnect_handler_test.cc"],
    deps = [
        ":stream_core",
        "@com_google_googletest//:gtest_main",
    ],
)